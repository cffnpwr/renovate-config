{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      // The mise cargo backend uses the crate datasource, whose default `cargo` versioning
      // pins as `=x.y.z`. mise cannot resolve that Cargo requirement syntax.
      // Remove this preset once https://github.com/renovatebot/renovate/discussions/44953 is resolved.
      "matchManagers": ["mise"],
      "matchDatasources": ["crate"],
      "versioning": "semver"
    }
  ]
}
